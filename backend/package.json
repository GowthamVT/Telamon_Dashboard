{
  "name": "snowflake-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express API layer serving live Snowflake analytics to the dashboard frontend",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "keygen": "node scripts/generate-keypair.js",
    "verify": "node scripts/verify-connection.js",
    "introspect": "node scripts/introspect-schema.js",
    "test": "node --test \"test/*.test.js\"",
    "dev:mock": "node scripts/mock-server.js",
    "verify:mongo": "node scripts/verify-mongo.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "mongodb": "^7.5.0",
    "morgan": "^1.11.0",
    "snowflake-sdk": "^3.1.0"
  }
}
