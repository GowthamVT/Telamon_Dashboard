# ============================================================================
# Copy this file to backend/.env and fill in real values.
# The dashboard reads MongoDB only; Snowflake has been removed.
# backend/.env is gitignored -- never commit it.
# ============================================================================

# ---- MongoDB source cluster (read-only) ----------------------------------
# The ECSite production database -- the ONLY source for the dashboard.
# Both MONGO_URI and MONGO_DATABASE are REQUIRED: the API refuses to boot without
# them rather than starting up and serving an empty dashboard.
#
# Get the string from Atlas -> Database -> Connect -> Drivers -> Node.js, then
# ADD the four query parameters below yourself (Atlas does not include them):
#
#   readPreference=secondaryPreferred  queries hit a replica, NEVER the primary
#                                      the field portal runs on. Most important.
#   retryWrites=false                  we never write; makes that explicit
#   maxPoolSize=6                      matches MONGO_POOL_MAX below
#
# The user must hold role `read` only. If the password contains @ : / ? # [ ] %
# it has to be percent-encoded, so prefer letters and digits.
#
# This file is gitignored. Never paste the URI into a chat, ticket or screenshot
# -- the password is embedded in it and cannot be revoked from those places.
MONGO_URI=
MONGO_DATABASE=

MONGO_POOL_MAX=6
# Hard cap on any single aggregation, so a runaway pipeline cannot pin a
# connection or load the production cluster indefinitely.
MONGO_QUERY_TIMEOUT_MS=60000
MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
MONGO_CONNECT_TIMEOUT_MS=15000

# ---- Server --------------------------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=dev

# ---- Cache ---------------------------------------------------------------
# Default time-to-live for cached query results, in seconds.
CACHE_TTL_SECONDS=300
# Max distinct cached entries before least-recently-used eviction kicks in.
CACHE_MAX_ENTRIES=500

# ---- Sync / freshness polling -------------------------------------------
# How often to fingerprint the MongoDB collections for changes, in seconds.
# 0 disables polling. A change invalidates the cache so the next request refetches.
SYNC_POLL_SECONDS=60
# Set false to disable the background watcher entirely (e.g. in tests).
SYNC_ENABLED=true

# ---- CORS / iframe embedding --------------------------------------------
# Comma-separated list of origins allowed to call this API.
# Include the origin of the PARENT page that will host the <iframe>.
# Use * only for local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated origins allowed to embed the frontend in an iframe.
# Becomes the CSP frame-ancestors directive. 'self' is always included.
FRAME_ANCESTORS=http://localhost:5173

# ---- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# ---- Logging -------------------------------------------------------------
# App log level: error | warn | info | debug
APP_LOG_LEVEL=info
