# ============================================================================
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored -- never commit it.
# ============================================================================

# ---- Snowflake connection ------------------------------------------------
SNOWFLAKE_ACCOUNT=KOA17766
SNOWFLAKE_USER=GOWTHAM
SNOWFLAKE_ROLE=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ECSITE
SNOWFLAKE_SCHEMA=ANALYTICS

# ---- Key-pair authentication ---------------------------------------------
# Path to the PKCS#8 private key generated by `npm run keygen`.
# Relative paths resolve from the repository root.
SNOWFLAKE_PRIVATE_KEY_PATH=keys/snowflake_key.p8
# Only set this if you generated the key with --passphrase. Leave blank otherwise.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ---- Connection pool -----------------------------------------------------
SNOWFLAKE_POOL_MIN=1
SNOWFLAKE_POOL_MAX=6
# Milliseconds a caller waits for a free connection before failing.
SNOWFLAKE_POOL_ACQUIRE_TIMEOUT_MS=30000
# Idle connections are evicted after this long.
SNOWFLAKE_POOL_IDLE_TIMEOUT_MS=300000
# Hard cap on any single statement, so a runaway query cannot pin a connection.
SNOWFLAKE_QUERY_TIMEOUT_MS=60000

# ---- Server --------------------------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=dev

# ---- Cache ---------------------------------------------------------------
# Default time-to-live for cached query results, in seconds.
CACHE_TTL_SECONDS=300
# Max distinct cached entries before least-recently-used eviction kicks in.
CACHE_MAX_ENTRIES=500

# ---- Sync / freshness polling -------------------------------------------
# How often to poll Snowflake for data changes, in seconds. 0 disables polling.
SYNC_POLL_SECONDS=60
# Set false to disable the background watcher entirely (e.g. in tests).
SYNC_ENABLED=true

# ---- CORS / iframe embedding --------------------------------------------
# Comma-separated list of origins allowed to call this API.
# Include the origin of the PARENT page that will host the <iframe>.
# Use * only for local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated origins allowed to embed the frontend in an iframe.
# Becomes the CSP frame-ancestors directive. 'self' is always included.
FRAME_ANCESTORS=http://localhost:5173

# ---- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# ---- Logging -------------------------------------------------------------
# App log level: error | warn | info | debug
APP_LOG_LEVEL=info

# ---- Dashboard descriptor ------------------------------------------------
# Path (relative to backend/) of the descriptor produced by `npm run introspect`.
# Leave unset to use the default backend/dashboard.config.json.
# DASHBOARD_CONFIG_PATH=dashboard.config.json
