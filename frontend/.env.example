# Copy to frontend/.env.local (gitignored) if you need to override defaults.

# Base URL of the backend API.
# Leave EMPTY for same-origin relative requests -- correct for `npm run dev`
# (Vite proxies /api) and for a production deploy where the API is co-hosted.
# Set it only when the API is on a different origin than the frontend, e.g.
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api to. Change if the backend PORT differs.
VITE_PROXY_TARGET=http://localhost:8080
